{
  "name": "iol-power-calculator",
  "productName": "IOL Power Calculator",
  "version": "1.0.1",
  "description": "Standalone IOL power evaluation for cataract surgery",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:win": "electron-forge package",
    "make": "electron-forge make && node scripts/make-win-zip.mjs",
    "make:portable": "npm run package && node scripts/make-win-zip.mjs",
    "lint": "echo \"No linting configured\"",
    "import:csv": "node scripts/import-valutazione-csv.mjs"
  },
  "author": {
    "name": "David Hartono",
    "email": "david@monogrid.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "electron": "^38.7.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "electron-squirrel-startup": "^1.0.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  }
}
