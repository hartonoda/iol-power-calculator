{
  "description": "IOL Type Suitability Calculation Rules",
  "howItWorks": {
    "summary": "Each IOL type starts with a base score of 100 percent. Points are deducted when measured parameters fall outside the acceptable range for that IOL type.",
    "scoring": [
      "Score starts at 100 percent for each IOL type",
      "Each parameter that is out of range deducts points from the score",
      "More demanding IOL types have stricter acceptable ranges and larger deductions",
      "The final score is clamped between 0 and 100"
    ],
    "interpretation": [
      "90-100: Excellent candidate",
      "70-89: Good candidate with minor concerns",
      "50-69: Fair candidate, consider alternatives",
      "Below 50: Poor candidate, significant concerns"
    ]
  },
